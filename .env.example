# Required for story, image, and narration generation
OPENAI_API_KEY=

# Optional model overrides
RINGSIDE_TEXT_MODEL=gpt-5.6
RINGSIDE_IMAGE_MODEL=gpt-image-2
RINGSIDE_TTS_MODEL=gpt-4o-mini-tts
RINGSIDE_TTS_VOICE=cedar

# Publishing safety. Keep false for the first 5-10 episodes.
RINGSIDE_AUTO_PUBLISH=false

# Paths are relative to the project root unless absolute.
YOUTUBE_CLIENT_SECRET=secrets/client_secret.json
YOUTUBE_TOKEN=secrets/youtube_token.json

# iPhone/cloud deployment alternative. Store these as GitHub Actions secrets,
# never in this file when it will be committed to a repository.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET_VALUE=
YOUTUBE_REFRESH_TOKEN=

# Optional extra safety lock. The channel title is always checked against
# RINGSIDE REWRITE; adding the ID makes the lock even stricter.
YOUTUBE_EXPECTED_CHANNEL_ID=
